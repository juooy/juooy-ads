<?xml version="1.0" encoding="utf-8"?>
<!--
    Medium native ad card. Bind with NativeAdViewBinder.bind().
    Only framework theme attributes (?android:attr/*) so any consumer theme resolves them.
    Text sizes in sp, no autoSize, no maxLines: user font scaling must stay intact and never truncate.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/juooy_ads_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/juooy_ads_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/juooy_ads_badge_bg"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/juooy_ads_badge"
            android:textColor="@color/juooy_ads_badge_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/juooy_ads_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/juooy_ads_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/juooy_ads_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- MediaView: required by AdMob policy for main image/video, min 120dp -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/juooy_ads_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/juooy_ads_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:textSize="16sp" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
